<%- include('../partials/header') %>
  <div class="container">
    <h2>Grade Submission</h2>
    
    <div class="submission-info">
      <p><strong>Task:</strong> <%= task.title %></p>
      <p><strong>Student:</strong> <%= student.name %></p>
      <% if (submission) { %>
        <p><strong>Submitted on:</strong> <%= submission.submissionDate.toLocaleString() %></p>
      <% } %>
    </div>
    
    <form action="/teacher/tasks/<%= task._id %>/grade/<%= student._id %>" method="POST">
      <div class="form-group">
        <label for="marks">Marks:</label>
        <input type="number" id="marks" name="marks" min="0" max="100" 
               value="<%= existingGrade ? existingGrade.marks : '' %>" required>
      </div>
      
      <div class="form-group">
        <label for="remarks">Remarks:</label>
        <textarea id="remarks" name="remarks" rows="4"><%= existingGrade ? existingGrade.remarks : '' %></textarea>
      </div>
      
      <div class="form-group">
        <input type="checkbox" id="markCompleted" name="markCompleted">
        <label for="markCompleted">Mark task as completed</label>
      </div>
      
      <button type="submit" class="btn">Submit Grade</button>
      <a href="/teacher/tasks/<%= task._id %>/submissions" class="btn cancel-btn">Cancel</a>
    </form>
  </div>

  <style>
  body {
    font-family: 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, #1d2b64, #f8cdda);
    margin: 0;
    padding: 0;
    color: #2c3e50;
  }

  .container {
    max-width: 700px;
    margin: 40px auto;
    padding: 30px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  }

  h2 {
    text-align: center;
    margin-bottom: 30px;
    color: #34495e;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.2);
  }

  .submission-info {
    background: #ecf0f1;
    padding: 20px;
    border-left: 6px solid #3498db;
    border-radius: 10px;
    margin-bottom: 25px;
    font-size: 1rem;
  }

  .submission-info p {
    margin: 8px 0;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  label {
    font-weight: 600;
    margin-bottom: 6px;
    color: #2c3e50;
  }

  input[type="number"],
  textarea {
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #bdc3c7;
    font-size: 1rem;
    transition: border-color 0.2s ease-in-out;
  }

  input[type="number"]:focus,
  textarea:focus {
    outline: none;
    border-color: #3498db;
  }

  #markCompleted {
    margin-right: 10px;
    transform: scale(1.2);
  }

  .form-group input[type="checkbox"] + label {
    display: inline;
    font-weight: normal;
    font-size: 0.95rem;
  }

  .btn {
    padding: 12px 20px;
    border-radius: 8px;
    border: none;
    background-color: #2ecc71;
    color: white;
    font-size: 1rem;
    font-weight: bold;
    text-decoration: none;
    text-align: center;
    transition: background-color 0.3s ease;
    cursor: pointer;
  }

  .btn:hover {
    background-color: #27ae60;
  }

  .cancel-btn {
    background-color: #e74c3c;
    margin-left: 10px;
  }

  .cancel-btn:hover {
    background-color: #c0392b;
  }

  /* Responsive Enhancements */
  @media (max-width: 600px) {
    .form-group {
      gap: 10px;
    }

    .btn,
    .cancel-btn {
      width: 100%;
      margin-left: 0;
    }

    form {
      gap: 15px;
    }
  }
</style>

<%- include('../partials/footer') %>