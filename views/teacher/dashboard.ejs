<%- include('../partials/header') %>
  <div class="container">
    <h2>Teacher Dashboard - Welcome, <%= teacher.name %>
    </h2>

    <% if (successMessage) { %>
      <div class="success-message">
        <p>
          <%= successMessage %>
        </p>
      </div>
      <% } %>
        <div class="quick-actions">
          <a href="/teacher/tasks/add" class="btn">Add New Task</a>
          <a href="/teacher/attendance/mark" class="btn">Mark Attendance</a>
        </div>

        <section class="recent-tasks">
          <h3>Recently Assigned Tasks</h3>
          <% if (tasks.length> 0) { %>
            <table>
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Assigned To</th>
                  <th>Deadline</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% tasks.forEach(task=> { %>
                  <tr>
                    <td>
                      <%= task.title %>
                    </td>
                    <td>
                      <%= task.assignedTo.name %>
                    </td>
                    <td>
                      <%= task.deadline.toDateString() %>
                    </td>
                    <td class="<%= task.status %>">
                      <%= task.status %>
                    </td>
                    <td>
                      <a href="/teacher/tasks/<%= task._id %>/submissions">View Submissions</a>
                    </td>
                  </tr>
                  <% }); %>
              </tbody>
            </table>
            <% } else { %>
              <p>No tasks assigned yet.</p>
              <% } %>
        </section>

        <section class="students">
          <h3>Students</h3>
          <% if (students.length> 0) { %>
            <ul>
              <% students.forEach(student=> { %>
                <li>
                  <%= student.name %> (Roll No: <%= student.rollNumber %>)
                </li>
                <% }); %>
            </ul>
            <% } else { %>
              <p>No students registered.</p>
              <% } %>
        </section>
  </div>
  <%- include('../partials/footer') %>
   <style>
  body {
    font-family: 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, #08865e, #1c0202);
    margin: 0;
    padding: 0;
    color: #f0f0f0;
  }

  .container {
    width: 95%;
    max-width: 1200px;
    margin: 3rem auto;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(14px);
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
  }

  h2, h3 {
    text-align: center;
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.5);
    margin-bottom: 1rem;
  }

  .success-message {
    background-color: #2ecc71;
    padding: 1rem;
    border-radius: 10px;
    text-align: center;
    margin-bottom: 1.5rem;
    font-weight: bold;
    color: #fff;
  }

  /* Quick Action Buttons */
  .quick-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .btn {
    background-color: rgba(255, 255, 255, 0.1);
    color: #f0f0f0;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s ease;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
    color: #fff;
  }

  /* Table Styling */
  .recent-tasks table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    overflow: hidden;
  }

  .recent-tasks th, .recent-tasks td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .recent-tasks th {
    background: rgba(255, 255, 255, 0.1);
    color: #f9f9f9;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  .recent-tasks td {
    font-size: 0.95rem;
  }

  .recent-tasks tr:hover {
    background-color: rgba(255, 255, 255, 0.06);
    transition: 0.3s ease;
  }

  td.completed {
    color: #2ecc71;
    font-weight: bold;
  }

  td.pending {
    color: #f39c12;
    font-weight: bold;
  }

  td.failed {
    color: #e74c3c;
    font-weight: bold;
  }

  /* Students Section */
  .students ul {
    list-style-type: none;
    padding-left: 0;
    margin-top: 1rem;
  }

  .students li {
    padding: 0.75rem 1rem;
    margin: 0.4rem 0;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    font-size: 0.95rem;
    display: flex;
    justify-content: space-between;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .quick-actions {
      flex-direction: column;
      align-items: center;
    }

    .recent-tasks table, .students ul {
      font-size: 0.85rem;
    }

    .container {
      padding: 1rem;
    }
  }
</style>
