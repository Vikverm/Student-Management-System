<%- include('../partials/header') %>
<div class="container">
  <h2>My Tasks</h2>
  
  <div class="task-actions">
    <a href="/student/dashboard" class="btn">Back to Dashboard</a>
  </div>
  
  <% if (tasks.length > 0) { %>
    <div class="task-filters">
      <label>Filter by status:</label>
      <select id="statusFilter" onchange="filterTasks()">
        <option value="all">All Tasks</option>
        <option value="pending">Pending</option>
        <option value="completed">Completed</option>
      </select>
    </div>
    
    <div class="task-list">
      <% tasks.forEach(task => { %>
        <div class="task-card" data-status="<%= task.status %>">
          <div class="task-header">
            <h3><%= task.title %></h3>
            <span class="status-badge <%= task.status %>">
              <%= task.status.charAt(0).toUpperCase() + task.status.slice(1) %>
              <% if (new Date(task.deadline) < new Date() && task.status !== 'completed') { %>
                <span class="overdue-badge">Overdue</span>
              <% } %>
            </span>
          </div>
          
          <div class="task-meta">
            <p><strong>Assigned by:</strong> <%= task.assignedBy.name %></p>
            <p><strong>Assigned on:</strong> <%= task.assignedDate.toDateString() %></p>
            <p class="<%= new Date(task.deadline) < new Date() && task.status !== 'completed' ? 'overdue' : '' %>">
              <strong>Deadline:</strong> <%= task.deadline.toDateString() %>
            </p>
            <p><strong>Description:</strong> <%= task.description %></p>
          </div>
          
          <div class="task-footer">
            <% if (task.status === 'pending') { %>
              <a href="/student/tasks/<%= task._id %>/submit" class="btn submit-btn">Submit Work</a>
              <% if (task.submission) { %>
                <span class="submission-info">
                  Submitted on: <%= task.submission.submissionDate.toDateString() %>
                </span>
              <% } %>
            <% } else { %>
              <div class="task-completed">
                <% if (task.grade) { %>
                  <p class="grade-info">
                    <strong>Grade:</strong> <%= task.grade.marks %>/100
                    <% if (task.grade.remarks) { %>
                      | <strong>Remarks:</strong> <%= task.grade.remarks %>
                    <% } %>
                  </p>
                <% } %>
                <span class="completed-badge">Completed</span>
              </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="no-tasks">
      <p>No tasks have been assigned to you yet.</p>
    </div>
  <% } %>
</div>

<style>
  
  body {
    background: linear-gradient(135deg, #1e3c72, #2a5298);
    font-family: 'Segoe UI', sans-serif;
  }

  .container {
    max-width: 1000px;
    margin: 30px auto;
    padding: 20px;
    color: #f1f1f1;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(10px);
  }

  h2 {
    text-align: center;
    margin-bottom: 20px;
    font-size: 2rem;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .task-actions {
    text-align: center;
    margin-bottom: 20px;
  }

  .btn {
    background-color: #3498db;
    color: white;
    padding: 10px 20px;
    border-radius: 25px;
    font-weight: bold;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .btn:hover {
    background-color: #2980b9;
    transform: scale(1.05);
  }

  .task-filters {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    color: #ecf0f1;
  }

  .task-filters select {
    padding: 8px 12px;
    border-radius: 8px;
    border: none;
    background-color: #ecf0f1;
    color: #333;
    font-weight: bold;
  }

  .task-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 20px;
  }

  .task-card {
    background-color: rgba(255, 255, 255, 0.08);
    padding: 20px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 6px 18px rgba(0,0,0,0.3);
    transition: transform 0.3s;
    backdrop-filter: blur(6px);
  }

  .task-card:hover {
    transform: translateY(-5px);
  }

  .task-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #999;
    padding-bottom: 10px;
    margin-bottom: 10px;
  }

  .task-header h3 {
    margin: 0;
    color: #fff;
    font-size: 1.2rem;
  }

  .status-badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .status-badge.pending {
    background-color: #f39c12;
    color: white;
  }

  .status-badge.completed {
    background-color: #2ecc71;
    color: white;
  }

  .overdue-badge {
    background-color: #e74c3c;
    padding: 3px 8px;
    border-radius: 8px;
    font-size: 0.75rem;
    margin-left: 8px;
    display: inline-block;
  }

  .task-meta p {
    font-size: 0.9rem;
    margin: 6px 0;
  }

  .overdue {
    color: #ff6b6b;
    font-weight: bold;
  }

  .task-footer {
    border-top: 1px solid #ccc;
    padding-top: 10px;
    margin-top: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }

  .submit-btn {
    background-color: #16a085;
    padding: 8px 16px;
    border-radius: 8px;
    color: white;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-color 0.3s;
  }

  .submit-btn:hover {
    background-color: #13856c;
  }

  .submission-info {
    font-size: 0.8rem;
    color: #bdc3c7;
    margin-top: 6px;
  }

  .task-completed {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .grade-info {
    font-size: 0.9rem;
    color: #ecf0f1;
  }

  .completed-badge {
    background-color: #2ecc71;
    padding: 6px 12px;
    border-radius: 8px;
    color: white;
    font-weight: bold;
    font-size: 0.9rem;
    display: inline-block;
  }

  .no-tasks {
    background-color: rgba(255, 255, 255, 0.1);
    text-align: center;
    padding: 40px 20px;
    border-radius: 10px;
    color: #eee;
    margin-top: 40px;
  }

  .no-tasks p {
    font-size: 1.2rem;
  }


</style>

<script>
  function filterTasks() {
    const status = document.getElementById('statusFilter').value;
    const taskCards = document.querySelectorAll('.task-card');
    
    taskCards.forEach(card => {
      if (status === 'all' || card.dataset.status === status) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }
  
  // Initialize filter on page load if there's a hash in URL
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const filter = urlParams.get('filter');
    
    if (filter) {
      document.getElementById('statusFilter').value = filter;
      filterTasks();
    }
  });
</script>
<%- include('../partials/footer') %>