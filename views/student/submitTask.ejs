<%- include('../partials/header') %>
<div class="container">
  <h2>Submit Task: <%= task.title %></h2>
  
  <% if (typeof error !== 'undefined') { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>
  
  <% if (typeof success !== 'undefined') { %>
    <div class="alert alert-success">
      <%= success %>
    </div>
  <% } %>

  <div class="task-info">
    <p><strong>Assigned by:</strong> <%= task.assignedBy.name %></p>
    <p><strong>Deadline:</strong> <%= task.deadline.toDateString() %></p>
    <p><strong>Status:</strong> <span class="task-status <%= task.status %>"><%= task.status %></span></p>
    <p><strong>Description:</strong> <%= task.description %></p>
  </div>
  
  <% if (task.status !== 'completed') { %>
    <form action="/student/tasks/<%= task._id %>/submit" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label for="content">Your Submission:*</label>
        <textarea 
          id="content" 
          name="content" 
          rows="6" 
          required
          placeholder="Describe your submission here..."><%= typeof content !== 'undefined' ? content : '' %></textarea>
      </div>
      
      <div class="form-group">
        <label for="file">Upload File (Optional):</label>
        <input type="file" id="file" name="file">
        <% if (typeof existingFile !== 'undefined' && existingFile) { %>
          <p class="file-info">Previously uploaded: <%= existingFile %></p>
        <% } %>
      </div>
      
      <div class="form-actions">
        <button type="submit" class="btn submit-btn">Submit Task</button>
        <a href="/student/tasks" class="btn cancel-btn">Cancel</a>
      </div>
    </form>
  <% } else { %>
    <div class="submission-details">
      <h3>Your Submission</h3>
      <p><strong>Submitted on:</strong> <%= task.completedAt.toDateString() %></p>
      <div class="submission-content">
        <h4>Content:</h4>
        <p><%= submission.content %></p>
      </div>
      <% if (submission.fileUrl) { %>
        <div class="submission-file">
          <h4>Attached File:</h4>
          <a href="<%= submission.fileUrl %>" target="_blank" class="file-link">
            Download File
          </a>
        </div>
      <% } %>
      <a href="/student/tasks" class="btn back-btn">Back to Tasks</a>
    </div>
  <% } %>
</div>

<style>
  body {
    font-family: 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, #1e3c72, #2a5298);
    color: #f0f0f0;
    margin: 0;
    padding: 0;
  }

  .container {
    max-width: 850px;
    margin: 40px auto;
    padding: 30px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    color: #ffffff;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
  }

  .task-info {
    background: rgba(255, 255, 255, 0.08);
    border-left: 5px solid #3498db;
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 30px;
  }

  .task-info p {
    margin: 10px 0;
    font-size: 1rem;
  }

  .task-status {
    padding: 4px 10px;
    border-radius: 8px;
    font-weight: bold;
    text-transform: capitalize;
  }

  .task-status.pending {
    background-color: #f39c12;
    color: white;
  }

  .task-status.completed {
    background-color: #2ecc71;
    color: white;
  }

  .alert {
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-weight: bold;
    text-align: center;
  }

  .alert-error {
    background-color: rgba(231, 76, 60, 0.2);
    border: 1px solid #e74c3c;
    color: #e74c3c;
  }

  .alert-success {
    background-color: rgba(39, 174, 96, 0.2);
    border: 1px solid #2ecc71;
    color: #2ecc71;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
  }

  .form-group textarea,
  .form-group input[type="file"] {
    width: 100%;
    padding: 12px;
    font-size: 1rem;
    border-radius: 8px;
    border: 1px solid #ccc;
    background: #fdfdfd;
    color: #333;
  }

  .file-info {
    margin-top: 8px;
    font-size: 0.9rem;
    color: #ddd;
  }

  .form-actions {
    display: flex;
    gap: 15px;
    margin-top: 25px;
  }

  .btn {
    padding: 10px 20px;
    border: none;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s ease;
  }

  .submit-btn {
    background-color: #2ecc71;
    color: white;
  }

  .submit-btn:hover {
    background-color: #27ae60;
  }

  .cancel-btn {
    background-color: #e67e22;
    color: white;
  }

  .cancel-btn:hover {
    background-color: #d35400;
  }

  .back-btn {
    background-color: #3498db;
    color: white;
    display: inline-block;
    margin-top: 20px;
  }

  .back-btn:hover {
    background-color: #2980b9;
  }

  .submission-details {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 20px;
    border-radius: 10px;
  }

  .submission-content {
    background: white;
    color: #2c3e50;
    padding: 15px;
    margin-top: 10px;
    border-left: 5px solid #3498db;
    border-radius: 6px;
  }

  .submission-file {
    margin-top: 15px;
  }

  .file-link {
    display: inline-block;
    padding: 10px 15px;
    background-color: #2980b9;
    color: white;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
  }

  .file-link:hover {
    background-color: #1f6391;
  }

  @media (max-width: 600px) {
    .form-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      width: 100%;
    }

    .task-info,
    .submission-details {
      padding: 15px;
    }
  }
</style>

<%- include('../partials/footer') %>